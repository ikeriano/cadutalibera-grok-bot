-- Cada campo se aplica al Sound de SoundService con ese mismo nombre.
return {
	MusicaMenu = "rbxassetid://0", -- Música del menú (en bucle)
	MusicaDuelo = "rbxassetid://0", -- Música de fondo del duelo (en bucle)
	MusicaFinal = "rbxassetid://0", -- Música del juego final (en bucle)
	Cabecera = "rbxassetid://0", -- Sintonía de entrada del programa
	Acierto = "rbxassetid://0", -- Respuesta correcta
	Fallo = "rbxassetid://0", -- Respuesta incorrecta
	Paso = "rbxassetid://0", -- Cuando alguien dice «Paso»
	Tic = "rbxassetid://0", -- Tic de los últimos 5 segundos
	Reloj = "rbxassetid://0", -- Fin del tiempo (bocina)
